/**
* time.heasm
*
* @description libreria para el manejo de funciones de tiempo
*/

// --------------------------
//
// Tipos de estructuras
//
// --------------------------

/**
* EfiTime
*
* esto no esta sacado de la nada, es la estructura que devuelve la llamada 13 en orden
* 
* @param Second el segundo
* @param Minute el minuto
* @param Hour la hora
*
* @param Day el dia
* @param Month el mes
* @param Year el año
*/
swinc EfiTime
{
    //
    // hora
    //

    autv Second::LET;
    autv Minute::LET;
    autv Hour::LET;

    //
    // fecha
    //

    autv Day::LET;
    autv Month::LET;
    autv Year::LET;
}

// --------------------------
//
// estructuras globales
//
// --------------------------

autopbus __Time::swinc EfiTime

// --------------------------
//
// funciones
//
// --------------------------

/**
* GetTime
*
* @description obtiene la hora actual del sistema
* 
* @param __Time el tiempo
* @returns __Time el tiempo actual
*/
FUNCTION GetTime

    _CallOut 13 __Time.Second

    __asm ret