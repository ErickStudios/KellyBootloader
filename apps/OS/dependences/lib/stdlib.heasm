/**
* stdlib.heasm
*
* @description libreria para el manejo de funciones estandar
* 
* para estar al dia con el sistema incluyan stdlib.heasm antes de cualquier cosa en el .heasm del programa para que las
* variables de la System se sincronizen con las del sistema
* 
* pon
* ```heasm
* // incluir la libreria del sistema
* %include
*     dependences/lib/stdlib.heasm
* ```
* en tu archivo heasm para usar estas funciones
* o incluya uno por uno todos los archivos que necesite
*
* uso 
*
* un programa que imprime "Hello World!" y espera una tecla con un mensaje
* ```heasm
* %include
*   dependences/lib/stdlib.heasm
*
* // la funcion main esta establecida por stdlib.heasm como la funcion a la que salta para saltarse todas
* // las funciones de la libreria para luego usarlas
* FUNCTION main
*   Print "Hello\sWorld!\n"
*   Print "Press\sany\skey\sto\scontinue...\n"
*
*   call WaitForKey
*
*   _CallOut 0 0
*   // +- detener el programa
* ```
*
* la funcion main si es un tapot debe contener un argumento , solo uno que es la direccion a la estructura de parametros
* si no el compilador crasheara
*/

// esto para que las minusculas se conviertan a mayusculas y se les sume 32 para volverlas minusculas 
// para que el limite de 106 de CHAR8 no afecte
_Use ASCII

//
// llamar a la funcion main
//

call_tapot main System.System.ShellArgs.argx

//
// en la logica de hlvc si el tapot no existe entonces no se llama asi que si no se logro llamar entonces ir con el legacy para mantener la compatibilidad
//
call main

// --------------------------
//
// librerias basicas
//
// --------------------------

%include
    dependences/lib/time.heasm

%include
    dependences/lib/input.heasm
    
%include
    dependences/lib/outpud.heasm

// --------------------------
//
// librerias avanzadas
//
// --------------------------

%include
    dependences/lib/gfx.heasm

%include
    dependences/lib/shell.heasm

// --------------------------
//
// funciones del sistema
//
// -------------------------

/**
* VersionRevision
*
* @description representa una revision de version en formato Primary.Secondary.Revision
*
* @param Primary la version primaria
* @param Secondary la version secundaria
* @param Revision la revision
*/
swinc VersionRevision
{
    autv Primary::LET;
    autv Secondary::LET;

    autv Revision::LET;
}

/**
* SystemInternal
*
* @description representa una estructura del sistema
*
* @param SystemVer es un swinc de <VersionRevision> y contiene la version de la instancia del sistema
* @param SystemName es un array con el nombre del sistema
*/
swinc SystemInternal
{
    //
    // variables
    //

    autv SystemVer::swinc VersionRevision;
    autv SystemName::Array;

    //
    // outpud
    //

    autv CurPos::swinc ConsoleCurPos;
    autv CoutColor::swinc ConsoleColor;

    //
    // entrada
    //

    autv Key::swinc EfiInputKey;

    //
    // fua que buenos los graficos
    //

    autv CurrPixel::swinc Pixel;
    autv ScreenSize::swinc ScreenSizeConsole;

    //
    // el tiempo
    //

    autv Time::swinc EfiTime;

    //
    // protocolo de la shell
    //

    autv ShellArgs::swinc ParamsArgs;
}

/**
* System
*
* el sistema actual
*/
autopbus System::swinc SystemInternal

// --------------------------
//
// eran experimentos!
//
// -------------------------

#define _StdLib_ 1
#define _StdVer_ 0002

#define _TerminatorChar_ 0

// --------------------------
//
// variables
//
// -------------------------

LET __RetVal__
LET __WorckVar1__

// --------------------------
//
// funciones utiles
//
// -------------------------

/**
* _Power_
*
* @description potencia
*
* @param 0d1 numero
* @param 0d2 potencia
* 
* @returns 0d1 el resultado
* @returns Exception se queda colgado si es menor a 0 (si es negativo)
*/
tapot Power (Number,Exponent)

    3 = *Number

    call _PowerLOOP_

    // para que no me esten tambien molestando de que por que no uso la variable de retorno
    __RetVal__ = *1

END tapot

FUNCTION _PowerLOOP_

    // decrementar en cada iteracion la potencia
    __asm decrement 2

    // multiplicarlo
    _Math 1 * 3

    7 = *2
    8 = 0

    _CallOut 39 7

    4 = 0
    5 = __PowerLOOP__
    6 = 0

    _CallOut 40 4

    // si es 0 ya ejecutara ret, no se preocupen
__asm ret