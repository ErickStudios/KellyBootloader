# build.erc para los ejemplos de parametros

function Main

    compile

        [_Entry]
            # el nombre del archivo original
            build "ParamsAppStrange1.heasm"

            # el nombre del archivo del resultado
            As "ParamsAppStrange1.ebf"

            # compilarlo con el HLVC
            With "EASM_Hlvc"
        [end _Entry]

    end

stopScript()